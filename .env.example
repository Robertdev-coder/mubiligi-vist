# Copy to .env and fill in values. Never commit .env.

# Auth — must be at least 32 characters.
AUTH_SECRET=replace-with-a-32-plus-character-random-string

# Local database (used when Supabase is not configured).
LOCAL_DB_PATH=./data/mubiligi.db

# Supabase — leave blank/comment out to use the local SQLite backend.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Seeded local accounts (used on first run of the local database).
SEED_ADMIN_EMAIL=admin@mubiligi.rw
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEAN_EMAIL=dean@mubiligi.rw
SEED_DEAN_PASSWORD=Dean@12345
DEAN_EMAIL=dean@mubiligi.rw
